<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 小窗命令通道的签名级权限（Wire.PERMISSION） -->
    <permission
        android:name="${applicationId}.CONTROL"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.CONTROL" />

    <application>
        <!-- SystemUI 宿主读取设置的唯一入口（UID 校验） -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.settings"
            android:exported="true" />

        <provider
            android:name=".features.diagnostics.DiagnosticsProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
